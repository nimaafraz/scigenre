# Copy to .env and fill in. The code reads this file and never prints the keys.

# OpenAlex (free key at https://openalex.org); without it the keyless daily budget runs out quickly
OPENALEX_API_KEY=
# Optional: an e-mail address for OpenAlex's polite pool (leave empty to send none)
OPENALEX_MAILTO=

# Semantic Scholar Academic Graph API (https://www.semanticscholar.org/product/api); keyless requests are throttled
SEMANTIC_SCHOLAR_API_KEY=

# Elsevier / Scopus Search API (https://dev.elsevier.com); needed for Scopus abstracts (view COMPLETE)
ELSEVIER_API_KEY=

# Springer Nature Meta API (https://dev.springernature.com); needed for Springer Nature abstracts
SPRINGER_META_API_KEY=
